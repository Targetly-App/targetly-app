    "@genkit-ai/flow": "^0.5.17",
    "@genkit-ai/googleai": "^0.9.12",
    "@genkit-ai/vertexai": "^0.9.12",
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.2",
    "genkit": "^0.9.12",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
